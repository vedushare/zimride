# ZimRide Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
JWT_SECRET=change_me_to_a_long_random_string

# ─── SMS Provider ───────────────────────────────────────────────────────────
# Primary provider for Zimbabwe SMS (https://sms.localhost.co.zw)
# Leave SMS_PROVIDER unset to auto-detect (uses localhostzw when API key is set,
# otherwise falls back to "console" for local development).
SMS_PROVIDER=localhostzw

# Get your API key from https://sms.localhost.co.zw/dashboard
LOCALHOSTZW_API_KEY=your_api_key_here
# Sender ID shown on recipient's phone (max 11 alphanumeric chars)
LOCALHOSTZW_SENDER_ID=ZimRide

# ─── Alternative: Twilio ────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ─── Alternative: Africa's Talking ──────────────────────────────────────────
# AT_USERNAME=sandbox
# AT_API_KEY=your_api_key
# AT_SENDER_ID=ZimRide
